<rml>
	<head>
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				font-family: "Funnel Display";
				font-weight: 650;
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
			}
			@keyframes scoreboard-appear {
				from {
					opacity: 0.0;
					transform: translateY(-12dp);
				}
				to {
					opacity: 1.0;
					transform: translateY(0dp);
				}
			}
			#scoreboard {
				position: absolute;
				top: 15%;
				left: 20%;
				width: 60%;
				height: 70%;
				/* border: 1dp #D89D74; */
				background-color: #2a2e3360;
				display: flex;
				flex-direction: column;
				color: #FFFFFF;
				transform-origin: 50% 50%;
			}
			#scoreboard.appear {
				animation: scoreboard-appear 0.18s cubic-out;
			}
			#header {
				display: flex;
				flex-direction: row;
				justify-content: space-between;
				align-items: center;
				height: 32dp;
				padding: 0 12dp;
				font-size: 15dp;
				flex-shrink: 0;
				decorator: repeating-linear-gradient(
					-45deg, 
					#00000000 0px,
					#00000000 10px, 
					#e4e9f050 10px, 
					#e4e9f050 20px
					);
			}
			#server-name {
				text-align: left;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				flex: 1;
				color: #FFFFFF;
				font-weight: bold;
			}
			#map-name {
				text-align: right;
				flex-shrink: 0;
				margin-left: 16dp;
				color: #e4e9f0;
				font-weight: bold;
			}
			#legend {
				display: flex;
				flex-direction: row;
				align-items: center;
				height: 28dp;
				font-size: 13dp;
				color: #e4e9f0;
				font-weight: bold;
				flex-shrink: 0;
				
			}
			#playerlist {
				flex: 1;
				display: block;
				overflow-y: auto;
			}
			.playerrow {
				display: flex;
				flex-direction: row;
				align-items: center;
				height: 31dp;
				font-size: 14dp;
				color: #DDDDDD;
			}
			.playerrow:nth-child(even) {
				background-color: #2a2e33;
			}
			.playerrow:hover {
				background-color: #2a2e33;
			}
			.thisplayer {
				color: #e4e9f0;
				font-weight: 700;
				decorator: repeating-linear-gradient(
					-45deg, 
					#00000000 0px,
					#00000000 5px, 
					#2a2e33 5px, 
					#2a2e33 10px
					);

			}
			.thisplayer .namecol
			{
				/* color: #2a2e33; */
			}
			.avatarcol {
				width: 32dp;
				height: 32dp;
				margin-left: 8dp;
				flex-shrink: 0;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.avatarimg {
				width: 32dp;
				height: 32dp;
				border: 1dp #444444;
			}
			.namecol {
				flex: 4;
				text-align: left;
				padding-left: 8dp;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.steamidcol {
				flex: 2.8;
				text-align: left;
				padding-left: 8dp;
				font-size: 11dp;
				/* color: #888888; */
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.fragscol {
				flex: 1.2;
				text-align: center;
			}
			.deathscol {
				flex: 1.2;
				text-align: center;
			}
			.pingcol {
				flex: 1.2;
				text-align: center;
				padding-right: 12dp;
			}
			#spec {
				display: flex;
				flex-direction: row;
				align-items: center;
				height: 26dp;
				padding: 0 12dp;
				font-size: 13dp;
				color: #999999;
				decorator: repeating-linear-gradient(
					-45deg, 
					#00000000 0px,
					#00000000 10px, 
					#e4e9f050 10px, 
					#e4e9f050 20px
					);
				flex-shrink: 0;
			}
			.noplayers {
				text-align: center;
				padding: 24dp;
				color: #777777;
				font-size: 14dp;
			}
			scrollbarvertical {
				width: 10dp;
			}
			scrollbarvertical slidertrack {
				background-color: #111111;
			}
			scrollbarvertical sliderbar {
				width: 10dp;
				min-height: 20dp;
				background-color: #D89D74;
			}
			scrollbarvertical sliderbar:hover {
				background-color: #FFA000;
			}
			scrollbarvertical sliderarrowdec,
			scrollbarvertical sliderarrowinc {
				display: none;
			}
		</style>
	</head>
	<body>
		<div id="scoreboard" data-model="scoreboard_model">
			<div id="header">
				<div id="server-name">{{server_name}}</div>
				<div id="map-name">{{map_name}}</div>
			</div>
			<div id="legend">
				<div class="avatarcol"></div>
				<div class="namecol">PLAYER</div>
				<div class="steamidcol">STEAM ID</div>
				<div class="fragscol">FRAGS</div>
				<div class="deathscol">DEATHS</div>
				<div class="pingcol">PING</div>
			</div>
			<div id="playerlist">
				<div class="noplayers" data-if="num_players == 0">No players connected</div>
				<div data-for="player : players">
					<div class="playerrow" data-class-thisplayer="player.thisplayer">
						<div class="avatarcol"><img class="avatarimg" data-attr-src="player.avatar" /></div>
						<div class="namecol">{{player.name}}</div>
						<div class="steamidcol">{{player.steamid}}</div>
						<div class="fragscol">{{player.frags}}</div>
						<div class="deathscol">{{player.deaths}}</div>
						<div class="pingcol">{{player.ping}}</div>
					</div>
				</div>
			</div>
			<div id="spec">
				Spectators: {{num_specs}}
			</div>
		</div>
	</body>
</rml>

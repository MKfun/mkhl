<rml>
	<head>
		<style>
			body
			{
				font-family: Lato;
				top: 5%;
                margin-left: auto;
                margin-right: auto;
                decorator: svg("images/notification_bg.svg" crop-to-content) content-box;

                display: block;
                width: 10%;
				height: 2.5%;
				text-align: center;
				position: absolute;
			}
			#container
			{
				overflow: hidden;
				position: relative;
				height: 100%;
				width: 100%;
				display: block;
			}
			h1
			{
				font-size: 16dp;
			}
			h2
			{
				font-size: 20dp;
			}
			#timer
			{
			    align-items: center;
				position: absolute;
				width: 50%;
                margin-left: auto;
                margin-right: auto;
			}
		</style>
	</head>
	<body data-model="roundtimer_model">
		<div id="container">
			<div id="timer">
			    <h1 data-if="minutes_left < 10">0</h1>
				<h1 data-if="minutes_left > 1">{{ minutes_left }}</h1>
				<h1 data-if="minutes_left > 1">:</h1>
				<h1 data-if="seconds_left < 10">0</h1>
				<h1>{{ seconds_left }}</h1>
			</div>
		</div>
	</body>
</rml>

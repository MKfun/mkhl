<rml>
	<head>
		<style>
			body {
				font-family: EternalUI Bold;
				width: 100%;
				height: 20%;
				position: absolute;
				top: 79%;
				margin: auto;
				bottom: 0;
				margin-bottom: -2dp;
			}
			#container {
				position: relative;
				height: 100%;
				width: 100%;
				bottom: 0;
			}
			.bottom-content {
				position: absolute;
				bottom: 0;
				width: 100%;
			}
			h1 {
				font-size: 36dp;
			}
			h2 {
				font-size: 14dp;
			}
			h3 {
				font-size: 12dp;
			}
			h4 {
				font-size: 18dp;
			}
			.row {
			}
			.col {
			}
			progress {
 				display: inline-block;
				border: 2dp #dddddd11;
				border-radius: 0dp;
				margin-left: 5dp;
				padding-left: 0;
				/* opacity: 0.70; */
                height: 15dp;
				top: 40%;
				/* background-color: #03030399; */
				min-width: 130dp;
								decorator: repeating-linear-gradient(
					-45deg, 
					#00000000 0dp,
					#00000000 5dp, 
					#2a2e3350 5dp, 
					#2a2e3350 10dp
					);
			}

			progress fill {
                margin: 0;
				background-color: #ffffff;
			}
			.hpdiv
			{
				display:inline-block;
				align-items: center;  
			}
			.hpcol
			{
 				display: flex;
				font-family: EternalUI Bold;
				bottom: 0;
			    position: absolute;
				flex-direction: column;
				width: 512dp;
				/* justify-content: center; */
				/* align-items: center; */
			}
			.critical
			{
			    color: red;
			}
			.critical fill
			{
			    background-color: #ff0000;
			}
			.imagediv
			{
                flex: 3;
                display: inline-block;
                padding-left: 15dp;
                height: 100%;
			}
			.image
			{
			    display: inline-block;
			    position: relative;
			}
			@keyframes kill-pop {
				0% { transform: scale(1.0); color: white; }
				50% { transform: scale(2.0); color: red; }
				100% { transform: scale(1.0); color: white; }
			}
			.kill-anim {
				animation: kill-pop 0.3s;
			}
			.footer
			{
				display: flex;
				/* justify-content: ; */
				width: 80%;
				height: 8dp;
				/* margin-left: -5dp; */
				padding: 0;
				decorator: repeating-linear-gradient(
					-45deg, 
					#00000000 0dp,
					#00000000 10dp, 
					#e4e9f0 10dp, 
					#e4e9f0 20dp
					);
			}
			.ammocol
			{
				display: flex;
				flex-direction: column;
				display: flex;
			    position: absolute;
				bottom: 0;
				right: 0;
				width: 150dp;
			}
			.ammocol .footer
			{
				width: 100%;
			}
			.mainammo
			{
				display: flex;
				flex-direction: row;
			}
			.hpcoltext
			{
				min-width: 46px;
			}
			.stats
			{
				display: flex;
				flex-direction: column;
				max-width: 210dp;
				min-width: 210dp;
			}
			.underlabel
			{
				display: flex;
				flex-direction: row;
				align-items: center;
			}
			.mainsection
			{
				display: flex;
				flex-direction: row;
			}
			.hp-bar-container {
				display: flex;
				position: relative;
				border-radius: 0dp;
				margin-left: 5dp;
				padding-left: 0;
				opacity: 0.70;
                height: 15dp;
				min-width: 130dp;
				max-width: 130dp;
				justify-content: center;
				/* top: 40%; */
			}
			.hp-bar-container progress {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				margin: 0;
				padding: 0;
			}
			.hp-bar-container progress.hp-damage {
				border: 2dp #dddddd11;
				border-radius: 0dp;
				/* background-color: #03030399; */
				opacity: 0.90;
			}
			.hp-bar-container progress.hp-damage fill {
				margin: 0;
				background-color: #FF2E93;
			}
			.hp-bar-container progress.hp-current {
				border: 2dp transparent;
				border-radius: 0dp;
				background-color: transparent;
				opacity: 1.0;
			}
			.hp-bar-container progress.hp-current fill {
				margin: 0;
				background-color: #ffffff;
			}
			.hp-bar-container progress.hp-current.critical fill {
				background-color: #ff0000;
			}
		</style>
	</head>
	<body>
		<div id="container">
			<div class="bottom-content" data-model="infobar_model">
				<div class="row" style="display:inline-block">
					<div class="hpcol" style="padding-left: 5dp; padding-bottom: 2dp; ">
						<div class="mainsection">
							<div class="stats">
								<p>HEALTH</p>
								<div class="underlabel">
									<h1 class="hpcoltext" id="HP" style="padding-left: 10dp;" data-class-critical="hp < 25">{{hp}}</h1>
									<!-- <progress data-value="hp" max=100 style="width:25%;" data-class-critical="hp < 25"/> -->
									 <div class="hp-bar-container" style="width:25%;">
										<progress class="hp-damage" data-value="damage_hp" max=100 />
										<progress class="hp-current" data-value="hp" max=100 data-class-critical="hp < 25" />
									</div>
								</div>
							</div>
							<div class="stats">
								<p>SUIT</p>
								<div class="underlabel">
									<h1 class="hpcoltext" id="AP" style="padding-left: 10dp;">{{armor}}</h1>
									<progress data-value="armor" max=100 style="width:25%;" > </progress>
								</div>
							</div>
						</div>
						<div class="footer"></div>
					</div>
					
					<div class="ammocol" data-if="ammo_reserve > 0">
						<h6 id="killAnim">x{{num_kills}}</h6>
						<div class="mainammo">
							<h1 data-if="has_ammo_reserve" id="current_ammo">{{ammo}} </h1>
							<h1 class="hl2-ammo-sep" data-if="has_ammo_reserve"> | </h1>
							<h1 data-if="has_ammo_reserve" id="reserve_ammo">{{ammo_reserve}}</h1>
							<h1 data-if="!has_ammo_reserve" id="reserve_ammo">{{ammo_reserve}}</h1>
						</div>
						<div class="footer"></div>
					</div>
				</div>
			</div>
		</div>
	</body>
</rml>
